# Copy to .env and fill in values. Never commit .env.
GHOSTREPO_GITHUB_TOKEN=
# Optional: used to enrich dependency reports with "latest" versions.
# Without this, GhostRepo still works but marks latest as "unknown" instead of guessing.
GHOSTREPO_OFFLINE=0
# Optional: OpenAI-compatible enhancement (entirely optional, off by default)
OPENAI_API_KEY=
